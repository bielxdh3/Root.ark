{
  "description": "Shared portable relative-path cases. Mirrors validatePortableRelativePath in sync-client/rootark-sync-paths.js. Consumed by the Node contract test test/issue-64-android-contract.test.js and by the Kotlin PortablePathValidatorTest. An entry uses either \"path\" or \"repeat\" {char, count}.",
  "cases": [
    { "name": "simple file", "path": "safe.txt", "valid": true },
    { "name": "nested file", "path": "folder/nested/file.txt", "valid": true },
    { "name": "spaces in segments", "path": "folder with space/a b.txt", "valid": true },
    { "name": "non-ascii name", "path": "fotos/cafe-\u00e7\u00e3o.txt", "valid": true },
    { "name": "dot inside segment", "path": "dir.name/file.txt", "valid": true },
    { "name": "reserved-looking prefix without dot", "path": "CONSOLE.txt", "valid": true },
    { "name": "internal-looking name without exact match", "path": ".rootark-syncfoo/file.txt", "valid": true },
    { "name": "max length 512", "repeat": { "char": "a", "count": 512 }, "valid": true },
    { "name": "empty", "path": "", "valid": false },
    { "name": "over max length 513", "repeat": { "char": "a", "count": 513 }, "valid": false },
    { "name": "parent traversal", "path": "../escape.txt", "valid": false },
    { "name": "inner parent traversal", "path": "folder/../escape.txt", "valid": false },
    { "name": "current directory segment", "path": "./file.txt", "valid": false },
    { "name": "bare dot", "path": ".", "valid": false },
    { "name": "empty segment", "path": "folder//file.txt", "valid": false },
    { "name": "trailing slash", "path": "folder/", "valid": false },
    { "name": "absolute posix", "path": "/abs.txt", "valid": false },
    { "name": "windows drive", "path": "C:/escape.txt", "valid": false },
    { "name": "drive-relative", "path": "c:relative.txt", "valid": false },
    { "name": "colon in segment", "path": "a:b.txt", "valid": false },
    { "name": "backslash", "path": "folder\\file.txt", "valid": false },
    { "name": "percent encoding", "path": "folder/%2e%2e/escape.txt", "valid": false },
    { "name": "percent literal", "path": "100%.txt", "valid": false },
    { "name": "control character U+0001", "path": "file\u0001.txt", "valid": false },
    { "name": "DEL character", "path": "file\u007f.txt", "valid": false },
    { "name": "reserved CON", "path": "CON", "valid": false },
    { "name": "reserved nul with extension", "path": "nul.txt", "valid": false },
    { "name": "reserved com1 in nested folder", "path": "docs/com1.log", "valid": false },
    { "name": "reserved LPT9 case-insensitive", "path": "lpt9.bin", "valid": false },
    { "name": "trailing dot", "path": "name.", "valid": false },
    { "name": "trailing dot on folder", "path": "dir./file", "valid": false },
    { "name": "trailing space", "path": "name ", "valid": false },
    { "name": "internal trash folder", "path": ".rootark-trash/hidden.txt", "valid": false },
    { "name": "internal sync lock", "path": ".rootark-sync.lock", "valid": false },
    { "name": "nested internal sync lock", "path": "nested/.rootark-sync.lock", "valid": false },
    { "name": "internal lock init prefix", "path": ".rootark-sync-lock-init-123-token", "valid": false },
    { "name": "internal sync state file", "path": ".rootark-sync-state.json", "valid": false },
    { "name": "internal sync journal, mixed case", "path": "Folder/.ROOTARK-SYNC-JOURNAL.json", "valid": false }
  ]
}
