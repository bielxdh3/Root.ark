# Copy this template for local reference only; do not commit a local secret.
# Replace REPLACE_ME with a freshly generated random JWT_SECRET before starting Root.ark.
JWT_SECRET=REPLACE_ME
PORT=3000

# Set only to explicit proxy addresses or CIDR ranges directly in front of the app.
# TRUSTED_PROXIES=127.0.0.1/32

# Optional test/development-only local defaults; requires NODE_ENV=development or test.
# ROOTARK_DEV_BOOTSTRAP_DEFAULTS=true

# One-time seed import; data/users.json must contain unique usernames and bcrypt hashes (cost >= 10).
# ROOTARK_BOOTSTRAP_USERS_FROM_SEED=true
