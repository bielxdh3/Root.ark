# Copy this template for local reference only; do not commit a local secret.
# Replace REPLACE_ME with a freshly generated random JWT_SECRET before starting Root.ark.
JWT_SECRET=REPLACE_ME
PORT=3000

# Production requires ClamAV and fail-closed handling. Configure ClamAV before deployment.
UPLOAD_SCAN_ENABLED=true
UPLOAD_SCAN_PROVIDER=clamav
UPLOAD_FAIL_CLOSED=true
UPLOAD_BLOCK_EXECUTABLES=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Custom extension lists replace the default set; production must retain every default entry.
# UPLOAD_SUSPICIOUS_EXTENSIONS=.exe,.bat,.cmd,.scr,.msi,.ps1,.vbs,.jar,.com,.custom
# Development/test bypasses must be explicit and require NODE_ENV=development or test:
# UPLOAD_SCAN_PROVIDER=disabled, UPLOAD_SCAN_ENABLED=false, or UPLOAD_FAIL_CLOSED=false. Other environments reject these.
# UPLOAD_QUARANTINE_DIR=./data/quarantine

# Chunk-upload staging quotas are required for /upload-chunk; choose byte limits from the host's actual staging and disk budget.
# CHUNK_UPLOAD_QUOTA_PER_ACCOUNT_BYTES=<required positive safe integer>
# CHUNK_UPLOAD_QUOTA_SYSTEM_BYTES=<required positive safe integer, at least the per-account limit>
# Entry limits bound SQLite operation rows plus unique session directories, including zero-byte operations and retained expiry tombstones.
# CHUNK_UPLOAD_QUOTA_PER_ACCOUNT_ENTRIES=<required positive safe integer>
# CHUNK_UPLOAD_QUOTA_SYSTEM_ENTRIES=<required positive safe integer, at least the per-account limit>
# CHUNK_UPLOAD_STORAGE_TOPOLOGY=single-host-local-volume
# There are no capacity defaults. Missing or invalid byte or entry limits disable chunk uploads only; an empty one-part file is accepted when the configured entry limits have room.
# This is an operator attestation, not replica discovery. Missing or invalid values disable chunk uploads only.
# No capacity is assumed here; known remote Linux filesystems and Windows UNC paths are rejected at startup.

# Dynamic HTTP/API ceiling per trusted client IP; default is 10x ROUTE_RATE_LIMIT_MAX.
# The in-memory store is per process. Use a shared store for a deployment-wide quota.
# API_RATE_LIMIT_MAX=600
# Accepted chunks per authenticated account within ROUTE_RATE_LIMIT_WINDOW_MS (default 900000 ms).
# Default 2000, bounded 1..20000; keep at least 2000 to allow a full maximum-size upload in one window.
# This in-memory quota is per process, not shared across workers or replicas.
# UPLOAD_CHUNK_RATE_LIMIT_MAX=2000

# Upload requests allowed from one direct socket peer within the same window.
# Default 20000, bounded 1..200000. Clients behind one proxy/NAT share this peer budget.
# This guard keys the socket peer and is also per process.
# UPLOAD_CHUNK_IP_RATE_LIMIT_MAX=20000

# Set only explicit trusted proxy peer IPs/CIDRs in the forwarding chain, including the direct socket peer. Do not use hop counts or catch-all ranges.
# TRUSTED_PROXIES=127.0.0.1/32

# Optional test/development-only local defaults; requires NODE_ENV=development or test.
# ROOTARK_DEV_BOOTSTRAP_DEFAULTS=true

# For S3-compatible endpoints without AWS STS identity, provide a stable,
# non-secret account/principal identifier. Cloud inventory fails closed without it.
# AWS_S3_PRINCIPAL_ID=storage-account-name

# One-time seed import; data/users.json must contain unique usernames and bcrypt hashes (cost >= 10).
# ROOTARK_BOOTSTRAP_USERS_FROM_SEED=true

# Legacy JSON fallback is disabled by default. Enable only after reviewing old JSON state.
# DB_READ_FALLBACK_JSON=true
