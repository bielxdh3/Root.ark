{
  "name": "servidor-drive",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node --watch server.js",
    "test": "node --test",
    "validate:syntax": "node scripts/validate-syntax.js",
    "validate:dependencies": "npm audit --package-lock-only --audit-level=high",
    "validate:artifacts": "node scripts/validate-runtime-artifacts.js",
    "validate:release-gate": "node scripts/validate-release-gate.js",
    "validate": "npm run validate:syntax && npm test && npm run validate:dependencies",
    "db:migrate": "node db/migrations.js",
    "db:migrate-json": "node db/migrate-json-to-sqlite.js",
    "db:backup": "node db/backup.js",
    "sync:init": "node sync-client/rootark-sync.js init",
    "sync:start": "node sync-client/rootark-sync-v2.js start",
    "sync:start:legacy-dev": "node sync-client/rootark-sync.js start --legacy-development-opt-in"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sts": "^3.1147.0",
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cborg": "6.1.3",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "googleapis": "^182.0.0",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers-sumo": "0.8.4",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "proxy-addr": "2.0.8",
    "qrcode": "^1.5.4",
    "unzipper": "^0.12.5",
    "word-extractor": "^1.0.4",
    "ws": "^8.22.0"
  },
  "license": "Apache-2.0"
}
